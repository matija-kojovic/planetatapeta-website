# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log
*.tmp
.cache/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets; .env.example documents the variables
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling
.agent/
.color-backup/
.claude/settings.local.json

# customer data — orders contain personal information and must never be committed
/data/database/orders.json
/data/database/*.bak
*.sql
*.dump

# files uploaded through the admin at runtime
/public/uploads/

# source/business files kept locally, not part of the application
/Slike shutterstock/
/Za sajt.xlsx
/slike/
