# Copy to .env.local for development. Never commit real values.
# In production, set these in the hosting provider's environment settings.

# Admin login. The admin stays locked until both are set.
# Password: at least 12 characters.
ADMIN_PASSWORD=
# HMAC key for the session cookie: at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it logs every admin out.
ADMIN_SESSION_SECRET=

# Gmail account and app password used to send order and contact e-mails.
# Without them, e-mails are skipped (orders are then only stored on disk, which
# does not work on Vercel; see README).
EMAIL_USER=
EMAIL_PASS=

# Inbox that receives order and contact notifications.
# Defaults to planetatapeta20@gmail.com when empty.
ORDER_NOTIFY_EMAIL=

# Public origin used for canonical URLs, the sitemap and structured data,
# e.g. https://www.example.rs (no trailing slash). Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
