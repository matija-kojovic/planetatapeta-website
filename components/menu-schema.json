{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://menu-system/schemas/menu-schema.json",
  "title": "HorizontalDropdownMenu",
  "description": "Schema and canonical data for a horizontally oriented dropdown navigation menu.",
  "type": "object",
  "required": ["menu"],
  "additionalProperties": false,

  "properties": {
    "menu": {
      "type": "object",
      "required": ["orientation", "categories"],
      "additionalProperties": false,
      "properties": {
        "orientation": {
          "type": "string",
          "enum": ["horizontal", "vertical"],
          "description": "Layout direction of the top-level menu bar."
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "description": "Top-level dropdown trigger items rendered in a row.",
          "items": { "$ref": "#/definitions/Category" }
        }
      }
    }
  },

  "definitions": {
    "Category": {
      "type": "object",
      "required": ["id", "label", "items"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "ASCII slug — lowercase letters, digits, underscores."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Display label — Unicode supported."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/MenuItem" }
        }
      }
    },
    "MenuItem": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "description": "Optional URL or route for the item link."
        }
      }
    }
  },

  "examples": [
    {
      "menu": {
        "orientation": "horizontal",
        "categories": [
          {
            "id": "digitalna_stampa",
            "label": "Digitalna štampa",
            "items": [
              { "id": "tapete",               "label": "Tapete" },
              { "id": "slike_na_platnu",      "label": "Slike na platnu" },
              { "id": "zidni_stikeri",        "label": "Zidni stikeri" },
              { "id": "izrada_nalepnica",     "label": "Izrada nalepnica" },
              { "id": "slike_na_pleksiglasu", "label": "Slike na pleksiglasu" }
            ]
          },
          {
            "id": "tekstil",
            "label": "Tekstil",
            "items": [
              { "id": "majice",  "label": "Majice" },
              { "id": "duksevi", "label": "Duksevi" },
              { "id": "jastuci", "label": "Jastuci" }
            ]
          },
          {
            "id": "reklamni_materijal",
            "label": "Reklamni materijal",
            "items": [
              { "id": "usb",               "label": "USB" },
              { "id": "eksterne_baterije",   "label": "Eksterne baterije" },
              { "id": "olovke",            "label": "Olovke" },
              { "id": "upaljaci",          "label": "Upaljači" }
            ]
          }
        ]
      }
    }
  ]
}
